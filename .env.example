# ==============================================================================
# LeadMap AI — Unified Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env (or .env.local for apps/web) AND POPULATE WITH REAL SECRETS.
# NEVER COMMIT ACTUAL SECRETS, CREDENTIALS, OR KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE CONFIGURATION (Laravel API)
# ------------------------------------------------------------------------------
APP_NAME="LeadMap AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Allowed CORS Origins for SPA / Next.js Client
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ------------------------------------------------------------------------------
# 2. FRONTEND PUBLIC ENVIRONMENT (Next.js - apps/web)
# ------------------------------------------------------------------------------
# Note: Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# DO NOT PUT SENSITIVE API KEYS HERE.
NEXT_PUBLIC_APP_NAME="LeadMap AI"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Mapbox Access Token (Client-side display only; restricted by domain)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 3. DATABASE (PostgreSQL 16)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=leadmap_ai
DB_USERNAME=leadmap_user
DB_PASSWORD=your_secure_db_password_here

# ------------------------------------------------------------------------------
# 4. CACHE, SESSIONS & QUEUES (Redis 7 + Laravel Horizon)
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
HORIZON_PREFIX=leadmap_horizon:

# ------------------------------------------------------------------------------
# 5. BUSINESS DISCOVERY (Google Maps Platform / Places API New)
# ------------------------------------------------------------------------------
# Server-side key only. Never expose to client-side code.
# Must have Places API (New) enabled with IP or server restrictions.
GOOGLE_PLACES_API_KEY=

# ------------------------------------------------------------------------------
# 6. AI PROVIDERS (OpenAI / Anthropic)
# ------------------------------------------------------------------------------
AI_DEFAULT_PROVIDER=openai

# OpenAI API Key (for GPT-4o structured JSON inference)
OPENAI_API_KEY=

# Anthropic API Key (Alternative / Fallback provider)
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 7. PAYMENTS & SUBSCRIPTIONS (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 8. CRM INTEGRATIONS (RiffCRM)
# ------------------------------------------------------------------------------
RIFFCRM_BASE_URL=https://api.riffcrm.com
RIFFCRM_API_KEY=

# ------------------------------------------------------------------------------
# 9. OBJECT STORAGE (S3-Compatible / Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
# Used for asynchronous CSV lead exports and report snapshots.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=leadmap-exports
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# 10. MAIL / NOTIFICATIONS (SMTP / Mailpit for local testing)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@leadmap.ai"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# 11. OBSERVABILITY & ERROR MONITORING (Sentry)
# ------------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
