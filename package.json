{
  "name": "leadmap-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "LeadMap AI — B2B SaaS Sales Intelligence & Local Prospecting Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm --prefix apps/web run dev",
    "build": "npm run build:types && npm run build:web && rm -rf .next && cp -r apps/web/.next ./.next && rm -rf public && cp -r apps/web/public ./public",
    "build:web": "npm --prefix apps/web run build",
    "start": "node apps/web/server.js",
    "lint": "npm run lint:web",
    "lint:web": "npm --prefix apps/web run lint",
    "typecheck": "npm run typecheck:web",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "test": "npm run test:web",
    "test:web": "npm --prefix apps/web run test",
    "build:types": "npm --prefix packages/shared-types run build",
    "deploy": "bash deploy.sh"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "keywords": [
    "lead-generation",
    "sales-intelligence",
    "google-places",
    "local-business",
    "saas"
  ],
  "author": "LeadMap AI Team",
  "license": "UNLICENSED"
}
