# ==============================================================================
# LeadMap AI — Hardened Production Caddy Reverse Proxy Configuration
# Protocol: HTTP/3 (QUIC), TLS 1.3, Rate Limiting, Cloudflare Proxy Trust
# ==============================================================================

{
    # Global Server Options
    email ops@leadmap.ai
    admin off
    servers {
        protocol {
            experimental_http3
            strict_sni_host
        }
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
    }
}

# Snippet: Enterprise Security Headers
(security_headers) {
    header {
        # Strict Transport Security (HSTS) with Preload
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"
        # Prevent Clickjacking
        X-Frame-Options "DENY"
        # Referrer Policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Restrict hardware API access
        Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(self)"
        # Cross-Origin Policies
        Cross-Origin-Opener-Policy "same-origin"
        # Remove Server Tokens
        -Server
    }
}

# ==============================================================================
# 1. API Service Domain (Laravel 11 Backend)
# ==============================================================================
api.leadmap.ai {
    import security_headers
    encode gzip zstd

    # CORS Headers for Trusted Web Frontends
    header {
        Access-Control-Allow-Origin "https://app.leadmap.ai"
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "DNT,X-CustomHeader,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Authorization,X-Workspace-ID,X-Request-ID"
        Access-Control-Allow-Credentials "true"
    }

    # Handle Pre-Flight CORS OPTIONS Requests
    @options method OPTIONS
    handle @options {
        respond 204
    }

    # Reverse Proxy to Laravel API Container
    reverse_proxy api:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Connection Pool
        transport http {
            keepalive 30s
            keepalive_idle_conns 100
        }
    }
}

# ==============================================================================
# 2. Web Application & Dashboard Domain (Next.js Frontend)
# ==============================================================================
app.leadmap.ai, www.leadmap.ai, leadmap.ai {
    import security_headers
    encode gzip zstd

    # Content Security Policy (CSP) for Next.js, Razorpay, Leaflet, and Google APIs
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://api.leadmap.ai https://*.tile.openstreetmap.org https://api.razorpay.com; frame-src https://api.razorpay.com; object-src 'none'; base-uri 'self';"
    }

    # Canonical Redirection to Primary Domain
    @canonical host leadmap.ai www.leadmap.ai
    handle @canonical {
        redir https://app.leadmap.ai{uri} permanent
    }

    # Route web application requests to Next.js container
    reverse_proxy web:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
